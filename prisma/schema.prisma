// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum PerfilUsuario {
  ADMIN
  ATENDENTE
}

// Fluxo completo definido em RN02 / 7-regras-negocio.md
enum StatusAtendimento {
  EM_SOLICITACAO
  AGUARDANDO_ORCAMENTO
  ORCAMENTO_REGISTRADO_AG_APROVACAO
  AGUARDANDO_RESERVA
  RESERVA_REGISTRADA_AG_ESCALA
  ESCALA_DEFINIDA
  SERVICO_EM_ANDAMENTO
  SERVICO_FINALIZADO
  ORCAMENTO_CANCELADO
  RESERVA_CANCELADA
  ATENDIMENTO_CANCELADO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  BOLETO
}

enum TipoServico {
  VIAGEM
  EXCURSAO
  PASSEIO
  FEIRA
  CONVENCAO
  CASAMENTO
  TRANSFERE
  OUTRO
}

enum TipoVeiculo {
  CARRO_PASSEIO
  VAN
  MICRO_ONIBUS
  ONIBUS
  OUTRO
}

// ─────────────────────────────────────────
// USUÁRIOS DO SISTEMA
// ─────────────────────────────────────────

model Usuario {
  id        String        @id @default(cuid())
  nome      String
  email     String        @unique
  senha     String
  perfil    PerfilUsuario @default(ATENDENTE)
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  atendimentosCriados    Atendimento[] @relation("AtendimentoCriadoPor")
  atendimentosCancelados Atendimento[] @relation("AtendimentoCanceladoPor")
  contratosGerados       Contrato[]

  @@map("usuarios")
}

// ─────────────────────────────────────────
// CLIENTES
// ─────────────────────────────────────────

model Cliente {
  id          String   @id @default(cuid())
  nome        String
  cpfCnpj     String   @unique
  rgIe        String?
  telefone    String
  telefoneSec String?
  email       String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  ativo       Boolean  @default(true)
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  atendimentos Atendimento[]

  @@map("clientes")
}

// ─────────────────────────────────────────
// RECURSOS OPERACIONAIS
// ─────────────────────────────────────────

model Motorista {
  id           String   @id @default(cuid())
  nome         String
  cpf          String   @unique
  telefone     String
  cnh          String
  cnhCategoria String
  cnhValidade  DateTime
  ativo        Boolean  @default(true)
  observacoes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  escalas EscalaMotorista[]

  @@map("motoristas")
}

model Veiculo {
  id          String      @id @default(cuid())
  placa       String      @unique
  modelo      String
  marca       String
  ano         Int
  capacidade  Int
  tipo        TipoVeiculo
  ativo       Boolean     @default(true)
  observacoes String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  escalas EscalaVeiculo[]

  @@map("veiculos")
}

model Parceiro {
  id          String   @id @default(cuid())
  nome        String
  cnpj        String   @unique
  telefone    String
  email       String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  ativo       Boolean  @default(true)
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  escalas EscalaParceiro[]

  @@map("parceiros")
}

// ─────────────────────────────────────────
// NÚCLEO DO SISTEMA: ATENDIMENTO
// ─────────────────────────────────────────

model Atendimento {
  id     String            @id @default(cuid())
  codigo String?           @unique // valor gerado em fase posterior
  status StatusAtendimento @default(EM_SOLICITACAO)

  // Dados da Solicitação (RF13)
  dataContato       DateTime
  dataServico       DateTime?
  qtdPassageiros    Int
  tipoServico       TipoServico
  precisaNotaFiscal Boolean     @default(false)
  trajeto           Json

  // Lead ou Cliente (clienteId nullable até a etapa de Reserva — RN05)
  clienteId    String?
  leadNome     String?
  leadTelefone String?

  // Operação
  criadoPor                  String
  statusAnteriorCancelamento StatusAtendimento?
  canceladoEm                DateTime?
  canceladoPor               String?
  observacoes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente             Cliente?   @relation(fields: [clienteId], references: [id])
  criadoPorUsuario    Usuario    @relation("AtendimentoCriadoPor", fields: [criadoPor], references: [id])
  canceladoPorUsuario Usuario?   @relation("AtendimentoCanceladoPor", fields: [canceladoPor], references: [id])
  orcamento           Orcamento?
  reserva             Reserva?
  escala              Escala?
  contratos           Contrato[]

  @@index([status])
  @@index([dataServico])
  @@index([clienteId])
  @@index([criadoPor])
  @@index([canceladoPor])
  @@map("atendimentos")
}

// ─────────────────────────────────────────
// ORÇAMENTO (RF17-RF21 / RN03)
// ─────────────────────────────────────────

model Orcamento {
  id                String         @id @default(cuid())
  atendimentoId     String         @unique
  valorTotal        Decimal        @db.Decimal(10, 2)
  formaPagamento    FormaPagamento
  dataVencimento    DateTime?
  // validoAte = createdAt + 7 dias corridos (RN03); usado para cancelamento automático
  validoAte         DateTime
  veiculosPrevistos Json
  observacoes       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id])

  @@index([validoAte])
  @@map("orcamentos")
}

// ─────────────────────────────────────────
// RESERVA (RF22-RF25 / RN04-RN05)
// ─────────────────────────────────────────

model Reserva {
  id            String   @id @default(cuid())
  atendimentoId String   @unique
  confirmadaEm  DateTime @default(now())
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id])

  @@map("reservas")
}

// ─────────────────────────────────────────
// ESCALA OPERACIONAL (RF26-RF28 / RN07)
// ─────────────────────────────────────────

model Escala {
  id            String   @id @default(cuid())
  atendimentoId String   @unique
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  atendimento Atendimento       @relation(fields: [atendimentoId], references: [id])
  motoristas  EscalaMotorista[]
  veiculos    EscalaVeiculo[]
  parceiros   EscalaParceiro[]

  @@map("escala")
}

model EscalaMotorista {
  escalaId    String
  motoristaId String
  observacoes String?

  escala    Escala    @relation(fields: [escalaId], references: [id])
  motorista Motorista @relation(fields: [motoristaId], references: [id])

  @@id([escalaId, motoristaId])
  @@map("escala_motoristas")
}

model EscalaVeiculo {
  escalaId    String
  veiculoId   String
  observacoes String?

  escala  Escala  @relation(fields: [escalaId], references: [id])
  veiculo Veiculo @relation(fields: [veiculoId], references: [id])

  @@id([escalaId, veiculoId])
  @@map("escala_veiculos")
}

model EscalaParceiro {
  escalaId     String
  parceiroId   String
  qtdVeiculos  Int
  tipoVeiculo  TipoVeiculo
  valorRepasse Decimal     @db.Decimal(10, 2)
  observacoes  String?

  escala   Escala   @relation(fields: [escalaId], references: [id])
  parceiro Parceiro @relation(fields: [parceiroId], references: [id])

  @@id([escalaId, parceiroId])
  @@map("escala_parceiros")
}

// ─────────────────────────────────────────
// CONTRATO (RF29-RF31)
// ─────────────────────────────────────────

model Contrato {
  id            String   @id @default(cuid())
  atendimentoId String
  nomeArquivo   String
  pdfUrl        String?
  geradoEm      DateTime @default(now())
  geradoPor     String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  atendimento      Atendimento @relation(fields: [atendimentoId], references: [id])
  geradoPorUsuario Usuario     @relation(fields: [geradoPor], references: [id])

  @@index([atendimentoId])
  @@index([geradoEm])
  @@index([geradoPor])
  @@map("contratos")
}
