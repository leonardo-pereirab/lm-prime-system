// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum PerfilUsuario {
  ADMIN
  ATENDENTE
}

// Fluxo completo definido em RN02 / 7-regras-negocio.md
enum StatusAtendimento {
  EM_SOLICITACAO
  AGUARDANDO_ORCAMENTO
  ORCAMENTO_REGISTRADO_AG_APROVACAO
  AGUARDANDO_RESERVA
  RESERVA_REGISTRADA_AG_ESCALA
  ESCALA_DEFINIDA
  SERVICO_EM_ANDAMENTO
  SERVICO_FINALIZADO
  ORCAMENTO_CANCELADO
  RESERVA_CANCELADA
  ATENDIMENTO_CANCELADO
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  BOLETO
}

// ─────────────────────────────────────────
// USUÁRIOS DO SISTEMA
// ─────────────────────────────────────────

model Usuario {
  id        String        @id @default(cuid())
  nome      String
  email     String        @unique
  senha     String
  perfil    PerfilUsuario @default(ATENDENTE)
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  atendimentos Atendimento[]

  @@map("usuarios")
}

// ─────────────────────────────────────────
// CLIENTES
// ─────────────────────────────────────────

model Cliente {
  id          String   @id @default(cuid())
  nome        String
  cpfCnpj     String   @unique
  rgIe        String?
  telefone    String
  email       String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  atendimentos Atendimento[]
  reservas     Reserva[]

  @@map("clientes")
}

// ─────────────────────────────────────────
// RECURSOS OPERACIONAIS
// ─────────────────────────────────────────

model Motorista {
  id           String    @id @default(cuid())
  nome         String
  cpf          String    @unique
  telefone     String
  cnh          String
  categoriaCnh String?
  cnhValidade  DateTime?
  ativo        Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  escalas Escala[]

  @@map("motoristas")
}

model Veiculo {
  id         String   @id @default(cuid())
  placa      String   @unique
  modelo     String
  marca      String
  ano        Int
  capacidade Int
  tipo       String
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  escalas Escala[]

  @@map("veiculos")
}

model Parceiro {
  id          String   @id @default(cuid())
  razaoSocial String
  cnpj        String?  @unique
  telefone    String
  email       String?
  contato     String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  escalas Escala[]

  @@map("parceiros")
}

// ─────────────────────────────────────────
// NÚCLEO DO SISTEMA: ATENDIMENTO
// ─────────────────────────────────────────

model Atendimento {
  id     String            @id @default(cuid())
  codigo String            @unique // ex: AT-2024-0001
  status StatusAtendimento @default(EM_SOLICITACAO)

  // Dados da Solicitação (RF13)
  dataContato    DateTime
  localSaida     String
  horaSaida      DateTime
  destino        String
  temRetorno     Boolean   @default(false)
  localRetorno   String?
  horaRetorno    DateTime?
  destinoRetorno String?
  qtdPassageiros Int
  tipoServico    String
  emiteNf        Boolean   @default(false)

  // Lead ou Cliente (clienteId nullable até a etapa de Reserva — RN05)
  clienteId    String?
  leadNome     String?
  leadTelefone String?

  // Operação
  usuarioId   String
  encerradoEm DateTime?
  observacoes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente   Cliente?   @relation(fields: [clienteId], references: [id])
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])
  orcamento Orcamento?
  reserva   Reserva?
  escala    Escala?
  contrato  Contrato?

  @@index([status])
  @@index([clienteId])
  @@index([usuarioId])
  @@index([dataContato])
  @@map("atendimentos")
}

// ─────────────────────────────────────────
// ORÇAMENTO (RF17-RF21 / RN03)
// ─────────────────────────────────────────

model Orcamento {
  id             String         @id @default(cuid())
  atendimentoId  String         @unique
  valorTotal     Decimal        @db.Decimal(10, 2)
  formaPagamento FormaPagamento
  vencimento     DateTime?
  // validoAte = createdAt + 7 dias corridos (RN03); usado para cancelamento automático
  validoAte      DateTime
  tiposVeiculos  String?
  qtdVeiculos    Int            @default(1)
  observacoes    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id])

  @@index([validoAte])
  @@map("orcamentos")
}

// ─────────────────────────────────────────
// RESERVA (RF22-RF25 / RN04-RN05)
// ─────────────────────────────────────────

model Reserva {
  id              String   @id @default(cuid())
  atendimentoId   String   @unique
  // clienteId obrigatório aqui: lead deve ter sido convertido em cliente (RN05)
  clienteId       String
  dataConfirmacao DateTime @default(now())
  observacoes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id])
  cliente     Cliente     @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@map("reservas")
}

// ─────────────────────────────────────────
// ESCALA OPERACIONAL (RF26-RF28 / RN07)
// ─────────────────────────────────────────

model Escala {
  id            String   @id @default(cuid())
  atendimentoId String   @unique
  // Pelo menos motorista OU parceiro deve ser informado
  motoristaId   String?
  veiculoId     String?
  parceiroId    String?
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id])
  motorista   Motorista?  @relation(fields: [motoristaId], references: [id])
  veiculo     Veiculo?    @relation(fields: [veiculoId], references: [id])
  parceiro    Parceiro?   @relation(fields: [parceiroId], references: [id])

  @@map("escala")
}

// ─────────────────────────────────────────
// CONTRATO (RF29-RF31)
// ─────────────────────────────────────────

model Contrato {
  id            String   @id @default(cuid())
  atendimentoId String   @unique
  // Texto preenchido automaticamente a partir dos dados do atendimento
  textoGerado   String   @db.Text
  urlPdf        String?
  geradoEm      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id])

  @@map("contratos")
}
